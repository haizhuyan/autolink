# 复制为 engine/.env 后填写；未配置 Key 时只跑启发式规则，不调用 LLM
# 同时配置时优先使用 DeepSeek

# DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 思考模式默认关闭（字段映射用不到），需要时设为 enabled
# DEEPSEEK_THINKING=enabled
# 费用估算单价（美元 / 百万 token），默认按 deepseek-flash 高峰价；换模型或调价时取消注释修改
# DEEPSEEK_PRICE_IN=0.3
# DEEPSEEK_PRICE_IN_CACHED=0.006
# DEEPSEEK_PRICE_OUT=1.2

# OpenRouter（备选）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
