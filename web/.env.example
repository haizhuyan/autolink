# 复制为 .env.local 并填写
# 会话签名密钥，至少 32 个字符。生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 后端 API 地址（仅服务端使用），默认 http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000
# 账号由后端管理：python -m backend.autolink_api.cli create-user --email you@example.com --admin
