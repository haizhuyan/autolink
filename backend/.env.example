# 复制为 backend/.env 后填写；backend/.env 已被 gitignore
# 必填：签发登录令牌的密钥，至少 32 个字符。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
API_SECRET=
# 可选：默认 SQLite 文件 data/private/autolink.db；PostgreSQL 示例：
# DATABASE_URL=postgresql+psycopg://autolink:密码@127.0.0.1:5432/autolink
DATABASE_URL=
# 可选：产品档案镜像目录（引擎从这里读），默认 data/private/products
PRODUCTS_DIR=
# 可选：登录令牌有效期（小时），默认 168
TOKEN_TTL_HOURS=168
